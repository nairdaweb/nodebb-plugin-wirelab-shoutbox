{
	"id": "nodebb-plugin-wirelab-shoutbox",
	"url": "https://github.com/nairdaweb/nodebb-plugin-wirelab-shoutbox",
	"library": "library.js",
	"hooks": [
		{ "hook": "static:app.load", "method": "init" },
		{ "hook": "static:privileges.global.init", "method": "addPrivileges" },
		{ "hook": "filter:admin.header.build", "method": "addAdminNavigation" },
		{ "hook": "filter:widgets.getWidgets", "method": "defineWidgets" },
		{ "hook": "filter:widget.render:shoutbox", "method": "renderWidget" }
	],
	"scss": ["scss/shoutbox.scss"],
	"scripts": ["public/shoutbox.js"],
	"modules": {
		"../admin/plugins/shoutbox.js": "public/admin.js"
	},
	"templates": "templates",
	"languages": "languages",
	"defaultLang": "en-GB"
}
