{
  "name": "nodebb-plugin-wirelab-shoutbox",
  "version": "1.1.0",
  "description": "Live shoutbox for NodeBB 4: a dock on every page (bottom sheet on phones) and a widget over the NodeBB websocket. Global read/write/moderate privileges, writing rules, mutes with a moderation log, mentions with notifications, emoji, optional rank-badges integration; translated (en-GB, pl).",
  "main": "library.js",
  "license": "MIT",
  "author": "nairda (https://wirelab.pl)",
  "homepage": "https://github.com/nairdaweb/nodebb-plugin-wirelab-shoutbox#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nairdaweb/nodebb-plugin-wirelab-shoutbox.git"
  },
  "bugs": {
    "url": "https://github.com/nairdaweb/nodebb-plugin-wirelab-shoutbox/issues"
  },
  "keywords": [
    "nodebb",
    "plugin",
    "nodebb-plugin",
    "shoutbox",
    "chat",
    "live-chat",
    "widget",
    "websocket",
    "moderation"
  ],
  "nbbpm": {
    "compatibility": "^4.15.0"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "library.js",
    "plugin.json",
    "lib/",
    "public/",
    "scss/",
    "templates/",
    "languages/",
